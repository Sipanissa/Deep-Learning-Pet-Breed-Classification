# Grundregel: alles ist gesperrt, nur ausdrücklich genannte Dateien werden freigegeben.
/*

!/.gitignore
!/.gitattributes
!/README.md
!/requirements.txt

# Quellcode
!/src/
/src/*
!/src/*.py

# Werkzeuge
!/tools/
/tools/*
!/tools/*.py

# Datensatz: nur Listen und Beschreibungen ohne Bilder
!/data/
/data/*
!/data/final_splits/
!/data/dataset_expansion/
/data/dataset_expansion/*
!/data/dataset_expansion/augmentation_plans/
/data/dataset_expansion/augmentation_plans/*
